{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bullish Trading Amm Instructions API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "amm-instructions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get AMM Instructions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.bullish.com/trading-api/v2/amm-instructions",
            "params": [
              {
                "name": "symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "order status"
              },
              {
                "name": "tradingAccountId",
                "value": "",
                "type": "query",
                "description": "Id of the trading account"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a list of AMM instructions based on applied filters.\n- requires [bearer token](/rest/authentication#add-authenticated-request-header) in authorization header\n- [supports pagination](/rest/general/pagination)\n\n**Ratelimited:** `True`\n"
        },
        {
          "info": {
            "name": "Create AMM Instruction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.bullish.com/trading-api/v2/amm-instructions",
            "headers": [
              {
                "name": "BX-SIGNATURE",
                "value": ""
              },
              {
                "name": "BX-TIMESTAMP",
                "value": ""
              },
              {
                "name": "BX-NONCE",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates an AMM instruction, requires [bearer token](/rest/authentication#add-authenticated-request-header) \nin authorization header.\n\nThis endpoint uses the [signing format](/rest/authentication#signing-format) which does not require strict field ordering\nin the request body. Quantities and prices does not require strict precision. \nE.g. for asset precision of 4 - `100`, `100.0`, `100.00`, `100.000` and `100.0000` are all accepted.\n\n**Ratelimited:** `True`\n"
        },
        {
          "info": {
            "name": "Get AMM Instruction by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.exchange.bullish.com/trading-api/v2/amm-instructions/:instructionId",
            "params": [
              {
                "name": "instructionId",
                "value": "",
                "type": "path",
                "description": "unique AMM instruction ID"
              },
              {
                "name": "tradingAccountId",
                "value": "",
                "type": "query",
                "description": "Id of the trading account"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets a specific AMM instruction based on the `instructionId`, \nrequires [bearer token](/rest/authentication#add-authenticated-request-header) in authorization header\n\n**Ratelimited:** `True`\n"
        },
        {
          "info": {
            "name": "Terminate AMM Instruction Command",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exchange.bullish.com/trading-api/v2/command#terminateAMMInstruction",
            "headers": [
              {
                "name": "BX-SIGNATURE",
                "value": ""
              },
              {
                "name": "BX-TIMESTAMP",
                "value": ""
              },
              {
                "name": "BX-NONCE",
                "value": ""
              },
              {
                "name": "BX-NONCE-WINDOW-ENABLED",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submits a command to the trading engine. A successful response indicates that the command entry was acknowledged \nbut does not indicate that the command was executed. \nThis endpoint uses the [signing format](/rest/authentication#signing-format) which does not require strict field \nordering and addition of null fields in the request body. Quantities and prices does not require strict precision. \nE.g. for asset precision of 4 - `100`, `100.0`, `100.00`, `100.000` and `100.0000` are all accepted.\n\n"
        }
      ]
    }
  ],
  "bundled": true
}