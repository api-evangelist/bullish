          "name": "Get Trades",
          "request": {
            "name": "Get Trades",
            "description": {
              "content": "Get a list of trades based on specified filters.\n- requires [bearer token](/rest/authentication#add-authenticated-request-header) in authorization header\n- Only the last 24 hours of data is available for querying\n- [supports pagination](/rest/general/pagination)\n- filtering on `createdAtDatetime`, `createdAtTimestamp` requires additional keywords, [see filtering support](/rest/general/filtering)\n\n**Ratelimited:** `True`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "trades"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "orderId",
                  "value": "<string>",
                  "description": "unique order ID"
                },
                {
                  "disabled": false,
                  "key": "clientOrderId",
                  "value": "<string>",
                  "description": "unique numeric (i64) identifier generated on the client side, only orderId or clientOrderId can be used"
                },
                {
                  "disabled": false,
                  "key": "tradingAccountId",
                  "value": "<string>",
                  "description": "(Required) Id of the trading account"
                },
                {
                  "disabled": false,
                  "key": "otcTradeId",
                  "value": "<string>",
                  "description": "unique Bullish otc trade id"
                },
                {
                  "disabled": false,
                  "key": "clientOtcTradeId",
                  "value": "<string>",
                  "description": "unique client otc trade id"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
