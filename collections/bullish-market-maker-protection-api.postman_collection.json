        {
          "id": "7c545ac9-fa42-48d5-948e-b00d9ae7e545",
          "name": "Get Market Marker Protection (MMP) by Trading Account ID",
          "request": {
            "name": "Get Market Marker Protection (MMP) by Trading Account ID",
            "description": {
              "content": "Get market maker protection configurations under a trading account id\n\nThis endpoint requires [authentication](/rest/authentication#generate-a-jwt-token). To filter by `symbol`, additional parameters are required. For detailed instructions, see the [Filtering Support](/rest/general/filtering) section.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "mmp-configuration"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbol",
                  "value": "<string>",
                  "description": "The underlying asset id you filter the configurations against. If symbol is provided, this API will only return the market maker protection configuration for this symbol for this trading account."
                },
                {
                  "disabled": false,
                  "key": "tradingAccountId",
                  "value": "<string>",
                  "description": "(Required) Id of the trading account"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "4a601995-978f-4f33-891c-c2d6f6a2cd2b",
              "name": "Status OK. This means a command was successfully acknowledged.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v2",
