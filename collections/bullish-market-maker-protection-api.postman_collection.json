                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "symbol",
                      "value": "BTC"
                    },
                    {
                      "key": "tradingAccountId",
                      "value": "111000000000001"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"tradingAccountId\": \"111000000000001\",\n  \"message\": \"No mmp config setup\",\n  \"mmpConfigurations\": [\n    {\n      \"underlyingAssetSymbol\": \"BTC\",\n      \"windowTimeInSeconds\": 60,\n      \"frozenTimeInSeconds\": 120,\n      \"quantityLimit\": \"100\",\n      \"deltaLimit\": \"10\",\n      \"isActive\": true\n    },\n    {\n      \"underlyingAssetSymbol\": \"BTC\",\n      \"windowTimeInSeconds\": 60,\n      \"frozenTimeInSeconds\": 120,\n      \"quantityLimit\": \"100\",\n      \"deltaLimit\": \"10\",\n      \"isActive\": true\n    }\n  ]\n}",
