              "raw": "{\n  \"commandType\": \"<string>\",\n  \"tradingAccountId\": \"<string>\",\n  \"underlyingAssetSymbol\": \"<string>\",\n  \"windowTimeInSeconds\": \"<string>\",\n  \"frozenTimeInSeconds\": \"<string>\",\n  \"quantityLimit\": \"<string>\",\n  \"deltaLimit\": \"<string>\"\n}",
              "options": {
