  "item": [
    {
      "id": "c717bac2-ca03-49c6-8668-1afc73e49925",
      "name": "transfer",
      "description": {
        "content": "Authenticated API for initiating asset transfers between trading accounts.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "05abfdd4-936d-4634-b92c-dd52bf1da363",
          "name": "Transfer Asset Command",
          "request": {
            "name": "Transfer Asset Command",
            "description": {
              "content": "Submits a command to the trading engine. A successful response indicates that the command entry was acknowledged \nbut does not indicate that the command was executed. \nThis endpoint uses the [signing format](/rest/authentication#signing-format) which does not require strict field \nordering and addition of null fields in the request body. Quantities and prices does not require strict precision. \nE.g. for asset precision of 4 - `100`, `100.0`, `100.00`, `100.000` and `100.0000` are all accepted.\n\nRequires\n- [bearer token](/rest/authentication#add-authenticated-request-header) in authorization header\n\n**Ratelimited:** `True`. Higher tiers of rate limits available by providing the `BX-RATELIMIT-TOKEN` request header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "command"
              ],
              "hash": "transferAsset",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) signature obtained using the [signing format](/rest/authentication#signing-format)",
                "key": "BX-SIGNATURE",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) timestamp is the number of milliseconds since EPOCH",
                "key": "BX-TIMESTAMP",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) nonce is a client side incremented unsigned 64 bit integer",
                "key": "BX-NONCE",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "string representation of a boolean value, [enables out-of-order order requests to be processed](/rest/order-processing-create-cancel-request-mechanism)\n",
                "key": "BX-NONCE-WINDOW-ENABLED",
                "value": "false"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commandType\": \"<string>\",\n  \"assetSymbol\": \"<string>\",\n  \"quantity\": \"<string>\",\n  \"fromTradingAccountId\": \"<string>\",\n  \"toTradingAccountId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
